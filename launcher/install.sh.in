#!/bin/sh
# Installs Dragoon.app in ~/Applications from a release's zip:
#   curl -fsSL https://github.com/lunchbox-recomp/dragoon/releases/latest/download/install.sh | sh
# launcher/tools/make_install_script.py writes this file for each release from
# launcher/install.sh.in, with the zip's URL and SHA-256 below.
#
# It needs an Apple silicon Mac on macOS 14 or later and refuses while this user's Dragoon or
# its game runs. It downloads the zip into a temporary folder, checks its SHA-256, unzips it
# beside the installed app and swaps the new app in, holding a lock so two copies can't swap at
# once. Builds and saves in ~/Library/Application Support/Dragoon stay as they are. It never
# runs sudo, never changes extended attributes and never installs Apple's Command Line Tools,
# which the launcher asks for itself.
#
# The script is one function, called on its last line, so a download cut short runs nothing.
set -eu

url='@URL@'
sha256='@SHA256@'

download=
stage=
locked=
swapped=

fail() {
	printf '%s\n' "$1" >&2
	exit 1
}

# Runs on every exit. Until the new app is in place, an earlier app moved aside goes back where
# it was. If something else is there by then, or the move back fails, it stays in the stage
# folder, which is kept and named. A second signal is ignored, so it can't stop this half done.
clean_up() {
	trap '' HUP INT TERM
	if [ -n "$download" ]; then rm -rf "$download" || :; fi
	if [ -n "$stage" ] && [ -z "$swapped" ] && { [ -e "$stage/previous.app" ] || [ -L "$stage/previous.app" ]; }; then
		if [ -e "$app" ] || [ -L "$app" ] || ! mv "$stage/previous.app" "$app"; then
			printf 'The app that was at %s is now at %s\n' "$app" "$stage/previous.app" >&2
			stage=
		fi
	fi
	if [ -n "$stage" ]; then rm -rf "$stage" || :; fi
	if [ -n "$locked" ]; then rmdir "$locked" || :; fi
}

install_dragoon() {
	# 1 on Apple silicon, under Rosetta too. An Intel Mac has no such key. sysctl is named by its
	# full path, since a PATH without /usr/sbin would otherwise read as Intel. The tests point
	# DRAGOON_INSTALL_SYSCTL at a fake.
	arm64=$("${DRAGOON_INSTALL_SYSCTL:-/usr/sbin/sysctl}" -n hw.optional.arm64 2> /dev/null || :)
	if [ "$arm64" != 1 ]; then
		fail "Dragoon needs a Mac with Apple silicon. This one has an Intel processor."
	fi
	version=$(sw_vers -productVersion)
	major=${version%%.*}
	case $major in
		'' | *[!0-9]*) fail "Dragoon needs macOS 14 or later. This Mac reports macOS $version." ;;
	esac
	if [ "$major" -lt 14 ]; then
		fail "Dragoon needs macOS 14 or later. This Mac has macOS $version."
	fi
	uid=$(id -u)
	if pgrep -x -U "$uid" Dragoon > /dev/null || pgrep -x -U "$uid" dragoon > /dev/null; then
		fail "Dragoon is open. Quit Dragoon and its game, then run this again."
	fi
	case ${HOME:-} in
		/*) ;;
		*) fail "HOME is '${HOME:-}', which isn't a full path. Nothing was installed." ;;
	esac

	apps="$HOME/Applications"
	app="$apps/Dragoon.app"
	trap clean_up EXIT
	trap 'exit 1' HUP INT TERM

	# A template, since macOS's mktemp -d alone ignores TMPDIR.
	download=$(mktemp -d "${TMPDIR:-/tmp}/dragoon-download.XXXXXX") ||
		fail "Couldn't make a temporary folder. Nothing was installed."
	printf 'Downloading %s\n' "$url"
	if ! curl -fsSL -g -o "$download/Dragoon.zip" "$url"; then
		fail "The download failed. Nothing was installed."
	fi
	got=$(shasum -a 256 "$download/Dragoon.zip" | cut -d ' ' -f 1)
	if [ "$got" != "$sha256" ]; then
		printf "The download's SHA-256 doesn't match the release's. Nothing was installed.\n" >&2
		printf '  release   %s\n' "$sha256" >&2
		printf '  download  %s\n' "$got" >&2
		exit 1
	fi

	mkdir -p "$apps" || fail "Couldn't make $apps. Nothing was installed."
	# No signal between taking the lock and noting it, so the trap always removes a lock it took.
	trap '' HUP INT TERM
	if ! mkdir "$apps/.Dragoon-install.lock" 2> /dev/null; then
		fail "Another copy of this installer is running. If none is, run rmdir \"$apps/.Dragoon-install.lock\" and then this again."
	fi
	locked="$apps/.Dragoon-install.lock"
	trap 'exit 1' HUP INT TERM
	stage=$(mktemp -d "$apps/.Dragoon-install.XXXXXX") ||
		fail "Couldn't make a folder in $apps. Nothing was installed."
	ditto -x -k "$download/Dragoon.zip" "$stage" || fail "Couldn't unzip the download. Nothing was installed."
	if [ ! -d "$stage/Dragoon.app" ]; then
		fail "The download holds no Dragoon.app. Nothing was installed."
	fi
	if [ -e "$app" ] || [ -L "$app" ]; then
		mv "$app" "$stage/previous.app"
	fi
	if [ -e "$app" ] || [ -L "$app" ]; then
		fail "Something else put a Dragoon.app in $apps during the install. Nothing was installed."
	fi
	if ! mv "$stage/Dragoon.app" "$app"; then
		fail "Couldn't move Dragoon.app into $apps. Nothing was installed."
	fi
	swapped=1
	printf 'Dragoon is in %s\n' "$apps"
	open "$app"
}

install_dragoon
